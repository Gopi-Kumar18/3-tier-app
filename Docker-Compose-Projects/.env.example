# Copy to .env for local `docker-compose up` only.
#
# In every other environment, Jenkins' Deploy stage pulls these from
# Jenkins Credentials and writes this file on the App EC2 immediately
# before `docker-compose up` — it is never committed and never lives
# in the repo with real values.
#
# Read two ways by docker-compose:
#   - substituted into ${VAR} references inside docker-compose.yml
#   - passed straight through to the backend container via its
#     `env_file: .env` directive

# Used by docker-compose.yml's ${...} substitution AND by the backend
# container (must match what server.js reads via process.env.MYSQL_*).
# The backend still authenticates as `root` today (same password as
# MYSQL_ROOT_PASSWORD below) — creating a dedicated least-privilege
# DB user/grant for the backend is a good follow-up hardening step,
# not done here to keep this change focused.
MYSQL_HOST=db
MYSQL_USER=root
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=school

# Public address of the reverse-proxy EC2 (or its domain) — this is
# what the *browser* calls, not a container hostname. Injected into
# the frontend container's env-config.js at startup.
API_BASE_URL=https://your-domain-or-reverse-proxy-ip
